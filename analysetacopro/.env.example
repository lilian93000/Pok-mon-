# ─────────────────────────────────────────────────────────────
# AnalyseTaCopro — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de données — PostgreSQL (Prisma) — Phase 4
DATABASE_URL="postgresql://user:password@localhost:5432/analysetacopro?schema=public"

# Authentification — NextAuth — Phase 5
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paiement — Stripe — Phase 8
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stockage fichiers — Supabase Storage — Phase 7
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# Emails transactionnels — Resend — Phase 9
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AnalyseTaCopro <contact@analysetacopro.fr>"
CONTACT_INBOX_EMAIL="contact@analysetacopro.fr"
