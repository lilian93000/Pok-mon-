# ─────────────────────────────────────────────────────────────
# AnalyseTaCopro — Variables d'environnement (exemple)
# Copier vers .env.local et renseigner les valeurs réelles.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Prisma) — Phase 4
DATABASE_URL="postgresql://user:password@localhost:5432/analysetacopro?schema=public"

# Authentification NextAuth — Phase 5
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # générer avec: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paiement Stripe — Phase 8
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stockage de fichiers Supabase — Phase 7
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Emails transactionnels Resend — Phase 3 / 9
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AnalyseTaCopro <contact@analysetacopro.fr>"

# URL publique de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
