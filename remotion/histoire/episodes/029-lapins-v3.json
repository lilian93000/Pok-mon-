  "beats": [
    {
      "text": "Napoléon a battu l'Europe… mais il a perdu contre des *LAPINS* !",
      "image": "portrait",
      "alt": "lapgris",
      "tag": "excited",
      "title": "NAPOLÉON ATTAQUÉ PAR DES LAPINS",
      "bg": "red",
      "rays": true
    },
    {
      "text": "Oui. Des *lapins*. C'est un général qui le raconte !",
      "image": "lapin",
      "tag": "laughs",
      "bg": "red",
      "rays": true
    },
    {
      "text": "Juillet *1807*.",
      "image": "nap1",
      "bg": "dark",
      "date": "JUILLET 1807",
      "tag": "curious"
    },
    {
      "text": "Napoléon est au *sommet* de sa puissance.",
      "image": "buste",
      "bg": "dark",
      "tag": "mischievously"
    },
    {
      "text": "Pour fêter la paix, son bras droit organise une *chasse*.",
      "image": "hunt21",
      "bg": "dark",
      "alt": "hunt19",
      "tag": "curious"
    },
    {
      "text": "Au menu : des *centaines* de lapins !",
      "image": "battue",
      "bg": "dark",
      "tag": "excited"
    },
    {
      "text": "On ouvre les cages… Napoléon *épaule*…",
      "image": "epee",
      "bg": "dark",
      "zoom": true,
      "tag": "whispers",
      "sfx": [
        "whisper"
      ]
    },
    {
      "text": "Et là… les lapins foncent droit sur *LUI* !",
      "image": "chasse",
      "tag": "excited",
      "bg": "red",
      "rays": true
    },
    {
      "text": "Ils grimpent sur ses *bottes* !",
      "image": "lapin2",
      "bg": "dark",
      "tag": "laughs"
    },
    {
      "text": "Sur ses *jambes* !",
      "image": "catch",
      "tag": "laughs",
      "bg": "red",
      "rays": true
    },
    {
      "text": "Ses hommes sortent les *fouets*… Rien à faire !",
      "image": "gulliver",
      "bg": "dark",
      "tag": "sarcastic"
    },
    {
      "text": "L'Empereur bat en *RETRAITE*… jusqu'à sa voiture !",
      "image": "carrosse",
      "bg": "dark",
      "tag": "laughs"
    },
    {
      "text": "L'explication ? Ce n'étaient pas des lapins *sauvages*…",
      "image": "chasse2",
      "bg": "dark",
      "tag": "mischievously"
    },
    {
      "text": "mais des lapins *DOMESTIQUES* !",
      "image": "lapin",
      "stamp": "DOMESTIQUES",
      "tag": "excited",
      "bg": "red",
      "rays": true
    },
    {
      "text": "Pour eux, un homme qui arrive… c'est l'heure du *repas* !",
      "image": "boulanger",
      "bg": "dark",
      "alt": "pudding",
      "tag": "laughs"
    },
    {
      "text": "Napoléon a battu l'Europe…",
      "image": "nap2",
      "bg": "dark",
      "zoom": true,
      "tag": "curious"
    }
  ]
