  "beats": [
    {
      "text": "Napoléon a battu l'Europe… mais il a perdu contre des *lapins*.",
      "image": "lapin",
      "bg": "red",
      "rays": true,
      "zoom": true,
      "alt": "chasse2",
      "title": "NAPOLÉON CONTRE LES LAPINS"
    },
    {
      "text": "Juillet *1807*. Il est au sommet de sa puissance.",
      "image": "portrait",
      "bg": "dark",
      "date": "1807",
      "alt": "gulliver"
    },
    {
      "text": "Pour fêter la paix, son bras droit organise une *chasse*.",
      "image": "chasse",
      "bg": "dark",
      "alt": "lapin2"
    },
    {
      "text": "Au menu : des lapins. Des *centaines*.",
      "image": "lapin2",
      "bg": "dark"
    },
    {
      "text": "On ouvre les cages. Napoléon *épaule*…",
      "image": "epee",
      "bg": "dark"
    },
    {
      "text": "Et les lapins foncent… droit sur *lui* !",
      "image": "lapin",
      "bg": "red",
      "rays": true,
      "zoom": true
    },
    {
      "text": "Ils grimpent sur ses *bottes*.",
      "image": "chasse2",
      "bg": "dark"
    },
    {
      "text": "Sur ses *jambes*.",
      "image": "gulliver",
      "bg": "dark"
    },
    {
      "text": "Ses hommes sortent les *fouets*. Rien à faire.",
      "image": "pudding",
      "bg": "dark"
    },
    {
      "text": "L'Empereur bat en *retraite*… jusqu'à sa voiture.",
      "image": "portrait",
      "bg": "red",
      "rays": true,
      "stamp": "RETRAITE",
      "alt": "vase"
    },
    {
      "text": "L'explication ? Ce n'étaient pas des lapins *sauvages*…",
      "image": "boulanger",
      "bg": "dark",
      "alt": "pudding"
    },
    {
      "text": "mais des lapins *domestiques*.",
      "image": "lapin2",
      "bg": "dark",
      "zoom": true
    },
    {
      "text": "Pour eux, un homme qui arrive… c'est l'heure du *repas* !",
      "image": "lapin",
      "bg": "red",
      "rays": true,
      "alt": "chasse"
    },
    {
      "text": "Voilà comment l'homme qui a conquis l'Europe…",
      "image": "portrait",
      "bg": "dark",
      "zoom": true
    }
  ]
}